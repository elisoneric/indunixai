# ==============================================================================
# INDUNIX AI - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env or paste these keys into your Coolify Environment tab
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN ROUTING
# ------------------------------------------------------------------------------
ENVIRONMENT=production
APP_URL=https://indunixai.com

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT TOKEN SIGNING
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
SECRET_KEY=your_64_character_random_secret_jwt_key_here_change_me_2026

# ------------------------------------------------------------------------------
# 3. POSTGRESQL LEDGER DATABASE
# Set POSTGRES_PASSWORD to a strong random string.
# Ensure the password in DATABASE_URL matches POSTGRES_PASSWORD.
# ------------------------------------------------------------------------------
POSTGRES_USER=indunix_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=indunix_db
DATABASE_URL=postgresql+asyncpg://indunix_user:your_strong_postgres_password_here@postgres:5432/indunix_db

# ------------------------------------------------------------------------------
# 4. REDIS IN-MEMORY TOKEN BUCKET RATE LIMITER & CACHE
# Inside Docker Compose network, the host is 'redis'
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 5. PAYSTACK PRODUCTION PAYMENT GATEWAY
# From your Paystack Dashboard (https://dashboard.paystack.com/#/settings/developer)
# Account registered under: Esam Creative Technologies
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_your_actual_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_actual_paystack_public_key

# ------------------------------------------------------------------------------
# 6. UPSTREAM AI INFERENCE PROVIDERS (ROUTED ANONYMOUSLY & PROPRIETARILY)
# - DEEPSEEK: Powers 'indunix-1-core' (V3) and 'indunix-1-reason' (R1)
#   Obtain key from: https://platform.deepseek.com/api_keys
# - GROQ: Powers 'indunix-1-spark' (Sub-second low latency LLaMA 3.3)
#   Obtain key from: https://console.groq.com/keys
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=
TOGETHER_API_KEY=

# Set to 'false' in production so real LLM calls are executed.
# Set to 'true' only if testing locally without upstream API credits.
MOCK_UPSTREAM_IF_UNSET=false

# ------------------------------------------------------------------------------
# 7. ENTERPRISE ON-PREMISE SOVEREIGN NODE SIGNING KEY
# Used to cryptographically sign 24h lease tokens for on-premise hardware
# ------------------------------------------------------------------------------
ENTERPRISE_LEASE_SIGNING_KEY=your_secure_enterprise_master_lease_signing_key_2026

# ------------------------------------------------------------------------------
# 8. CPANEL SMTP EMAIL DISPATCH (ROUNDCUBE WEBMAIL COMPATIBLE)
# Create an email account in cPanel (recommended: notifications@indunixai.com)
# Standard cPanel SSL Port: 465 (SMTP_USE_SSL=true, SMTP_USE_TLS=false)
# Standard cPanel TLS Port: 587 (SMTP_USE_SSL=false, SMTP_USE_TLS=true)
# ------------------------------------------------------------------------------
SMTP_HOST=mail.indunixai.com
SMTP_PORT=465
SMTP_USER=notifications@indunixai.com
SMTP_PASSWORD=your_cpanel_email_password_here
SMTP_FROM_EMAIL=notifications@indunixai.com
SMTP_FROM_NAME="Indunix AI"
SMTP_USE_SSL=true
SMTP_USE_TLS=false
ADMIN_NOTIFICATION_EMAIL=system@indunixai.com

