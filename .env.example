# Indunix AI Production Environment Template

# Security
SECRET_KEY=change-to-a-strong-64-character-secret-key-for-jwt-signing
ENVIRONMENT=production

# Database & Cache (PostgreSQL & Redis)
DATABASE_URL=postgresql+asyncpg://indunix_user:indunix_secure_pass_2026@postgres:5432/indunix_db
REDIS_URL=redis://redis:6379/0

# Paystack Merchant Credentials (Under Esam Creative Technologies)
PAYSTACK_SECRET_KEY=sk_live_your_actual_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_actual_paystack_public_key

# Upstream Model Inference Gateway (DeepSeek)
DEEPSEEK_API_KEY=your_deepseek_api_key_from_platform.deepseek.com
GROQ_API_KEY=your_optional_groq_api_key
MOCK_UPSTREAM_IF_UNSET=false

# Enterprise On-Premise Master Signing Key
ENTERPRISE_LEASE_SIGNING_KEY=your_enterprise_master_signing_key_2026
